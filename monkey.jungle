project.manifest = manifest.xml

# Touch-only games (see CustomMainMenuView.TOUCH_ONLY_GAMES) are hidden on
# non-touch devices anyway. On 96KB non-touch devices their code is left out
# of the build entirely (:touchGames) so the rest of the app fits in memory;
# every other device builds them and drops the empty fallback (:noTouchGames).
#
# Heavy games (see CustomMainMenuView.HEAVY_GAMES / Games.HAS_HEAVY_GAMES) -
# currently Pinball and Invaders, the two largest always-on games - are the
# same idea: on the lowest-memory devices their code is left out of the
# build entirely (:heavyGames) instead of just hidden at runtime, so the
# app still fits; every other device builds them normally and drops the
# empty fallback (:noHeavyGames).
base.excludeAnnotations = noTouchGames;noHeavyGames
descentg1.excludeAnnotations = touchGames;heavyGames
instinct2.excludeAnnotations = touchGames;heavyGames
instinct2s.excludeAnnotations = touchGames;heavyGames
instinct2x.excludeAnnotations = touchGames;heavyGames
instinctcrossover.excludeAnnotations = touchGames;heavyGames
